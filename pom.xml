<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>uk.gov.moj.cpp.common</groupId>
        <artifactId>service-parent-pom</artifactId>
        <version>17.104.0</version>
    </parent>

    <groupId>uk.gov.moj.cpp.material</groupId>
    <artifactId>material-parent</artifactId>
    <version>17.0.87-CAD-1412-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>material-parent</name>
    <description>
        The material project serves as digital service/repository context for CPP platform.
    </description>

    <properties>
        <sonar.report.export.path>sonar-report.json</sonar.report.export.path>
        <sonar.scm.provider>git</sonar.scm.provider>
        <coredomain.version>17.104.6</coredomain.version>
        <usersgroups.version>17.104.48</usersgroups.version>
        <stream-transformation-tool-anonymise.version>7.0.0</stream-transformation-tool-anonymise.version>
        <stream-transformation-tool.version>7.0.0</stream-transformation-tool.version>
        <mireportdata.cc.dependency.version>1.0.48</mireportdata.cc.dependency.version>
        <maven.failsafe.plugin.version>2.19.1</maven.failsafe.plugin.version>
        <jmeter.plugins.standard.version>1.3.1</jmeter.plugins.standard.version>
        <xml.maven.plugin.version>1.0.1</xml.maven.plugin.version>
        <rename.maven.plugin.version>1.0.1</rename.maven.plugin.version>
        <jmeter.lightning.maven.plugin.version>0.1.1</jmeter.lightning.maven.plugin.version>
        <junit4.version>4.13.1</junit4.version>
        <!--These azure lib versions override defined below are to be removed in
        PEG-377  as well as the corresponding entry in the dependencyManagement section -->
        <azure.functions.maven.plugin.version>1.24.0</azure.functions.maven.plugin.version>
        <material-azure.version>1.38.1</material-azure.version>
        <material-azure-storage.version>8.4.0</material-azure-storage.version>
        <!-- Azure SDK (com.azure) track-2 libs. Versions are aligned with the transitive
        requirements of azure-storage-blob 12.37.2 (no azure-sdk-bom release contains it yet).
        They override the older versions managed by service-parent-pom. -->
        <azure-storage-blob.version>12.37.2</azure-storage-blob.version>
        <azure-storage-common.version>12.36.2</azure-storage-common.version>
        <azure-storage-queue.version>12.32.2</azure-storage-queue.version>
        <!-- transitive via framework audit-client; must match azure-storage-blob (datalake uses blob internals) -->
        <azure-storage-file-datalake.version>12.30.2</azure-storage-file-datalake.version>
        <azure-core.version>1.61.0</azure-core.version>
        <azure-core-http-netty.version>1.17.0</azure-core-http-netty.version>
        <!-- netty / reactor-netty / reactor-core required by azure-core-http-netty ${azure-core-http-netty.version};
        service-parent-pom manages netty 4.1.77.Final, which is binary-incompatible with it -->
        <azure-netty.version>4.2.19.Final</azure-netty.version>
        <azure-reactor-netty.version>1.3.7</azure-reactor-netty.version>
        <azure-reactor-core.version>3.8.7</azure-reactor-core.version>
        <jgitflow.maven.developBranchName>main</jgitflow.maven.developBranchName>
    </properties>

    <modules>
        <module>material-command</module>
        <module>material-domain</module>
        <module>material-event</module>
        <module>material-integration-test</module>
        <module>material-performance-test</module>
        <module>material-query</module>
        <module>material-viewstore</module>
        <module>material-service</module>
        <module>material-client</module>
        <module>material-event-sources</module>
        <module>material-datatypes-common</module>
        <module>material-azure-functions</module>
        <module>material-healthchecks</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>uk.gov.moj.cpp.core.domain</groupId>
                <artifactId>common-core-domain</artifactId>
                <version>${coredomain.version}</version>
            </dependency>
            <dependency>
                <groupId>uk.gov.justice</groupId>
                <artifactId>stream-transformation-tool-anonymise</artifactId>
                <version>${stream-transformation-tool-anonymise.version}</version>
            </dependency>
            <dependency>
                <groupId>uk.gov.justice</groupId>
                <artifactId>stream-transformation-tool-api</artifactId>
                <version>${stream-transformation-tool.version}</version>
            </dependency>
            <dependency>
                <groupId>uk.gov.moj.cpp.core.domain</groupId>
                <artifactId>mireportdata-cc-dependency</artifactId>
                <version>${mireportdata.cc.dependency.version}</version>
            </dependency>
            <dependency>
                <groupId>junit</groupId>
                <artifactId>junit</artifactId>
                <version>${junit4.version}</version>
            </dependency>
            <dependency>
                <groupId>com.microsoft.azure</groupId>
                <artifactId>azure</artifactId>
                <version>${material-azure.version}</version>
            </dependency>
            <dependency>
                <groupId>com.microsoft.azure</groupId>
                <artifactId>azure-storage</artifactId>
                <version>${material-azure-storage.version}</version>
            </dependency>
            <dependency>
                <groupId>com.azure</groupId>
                <artifactId>azure-storage-blob</artifactId>
                <version>${azure-storage-blob.version}</version>
            </dependency>
            <dependency>
                <groupId>com.azure</groupId>
                <artifactId>azure-storage-common</artifactId>
                <version>${azure-storage-common.version}</version>
            </dependency>
            <dependency>
                <groupId>com.azure</groupId>
                <artifactId>azure-storage-queue</artifactId>
                <version>${azure-storage-queue.version}</version>
            </dependency>
            <dependency>
                <groupId>com.azure</groupId>
                <artifactId>azure-storage-file-datalake</artifactId>
                <version>${azure-storage-file-datalake.version}</version>
            </dependency>
            <dependency>
                <groupId>com.azure</groupId>
                <artifactId>azure-core</artifactId>
                <version>${azure-core.version}</version>
            </dependency>
            <dependency>
                <groupId>com.azure</groupId>
                <artifactId>azure-core-http-netty</artifactId>
                <version>${azure-core-http-netty.version}</version>
            </dependency>
            <dependency>
                <groupId>io.projectreactor</groupId>
                <artifactId>reactor-core</artifactId>
                <version>${azure-reactor-core.version}</version>
            </dependency>
            <dependency>
                <groupId>io.projectreactor.netty</groupId>
                <artifactId>reactor-netty-core</artifactId>
                <version>${azure-reactor-netty.version}</version>
            </dependency>
            <dependency>
                <groupId>io.projectreactor.netty</groupId>
                <artifactId>reactor-netty-http</artifactId>
                <version>${azure-reactor-netty.version}</version>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>${azure-netty.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-war-plugin</artifactId>
                <configuration>
                    <archiveClasses>true</archiveClasses>
                    <attachClasses>true</attachClasses>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
